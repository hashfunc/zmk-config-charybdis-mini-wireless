#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define LAYER_BASE 0
#define LAYER_AUTO_MOUSE 1
#define LAYER_SCROLL 2
#define LAYER_NUMBER 3

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors =
            <&zip_xy_scaler 1 1>,
            <&zip_temp_layer LAYER_AUTO_MOUSE 400>;

        scroll {
            layers = <LAYER_SCROLL>;
            input-processors =
                <&zip_xy_scaler 1 5>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <35 24>;
        };
    };

    behaviors {
        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC         &kp Q  &kp W  &kp E         &kp R             &kp T        &kp Y          &kp U    &kp I      &hold_tap LPAR O    &hold_tap RPAR P     &kp GRAVE
&kp TAB         &kp A  &kp S  &kp D         &kp F             &kp G        &kp H          &kp J    &kp K      &hold_tap LBKT L    &hold_tap RBKT SQT   &kp APOS
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V             &kp B        &kp N          &kp M    &kp COMMA  &hold_tap LBRC DOT  &hold_tap FSLH RBRC  &mo_tog LAYER_NUMBER LAYER_NUMBER
                              &kp LEFT_ALT  &kp LEFT_COMMAND  &kp SPACE    &kp BACKSPACE  &kp RET
            >;
        };

        AUTO-MOUSE {
            bindings = <
&trans  &trans  &trans  &trans     &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp LCLK  &trans  &mkp RCLK    &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        NUMBER {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp MINUS  &kp EQUAL  &kp BACKSLASH
&trans  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5       &kp N6     &kp N7    &kp N8    &kp N9     &kp N0     &trans
&trans  &trans    &trans  &trans    &trans    &trans       &trans     &trans    &trans    &trans     &trans     &trans
                          &trans    &trans    &trans       &trans     &trans
            >;
        };
    };
};
